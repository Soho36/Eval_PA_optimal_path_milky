  "purchase_policy": {
    "policy": "greedy_to_target",
    "cadence_days": null,
    "headroom_trigger_usd": null,
    "cash_reserve_usd": null,
    "role": "Treasury purchase timing is the staggering decision in this project. A PA container must be earned through a $35 Evaluation and arrives a median 61 days later, so the number of live PAs is an outcome of this rule rather than an input. target_pa_count_k is an upper bound for every policy, never a guarantee.",
    "available": {
      "greedy_to_target": "Buy whenever cash allows and the pipeline is below target_pa_count_k. Baseline and fastest acquisition.",
      "fixed_cadence": "At most one Evaluation per cadence_days, measured from the previous purchase and seeded at the cohort start. The one Accounts_staggering principle expected to transfer, because it is a rule about when to add capacity rather than a claim about how much.",
      "death_replacement": "Buy only to make good on PA deaths. Never grows the book beyond the size it already reached.",
      "headroom_triggered": "Buy when the least-cushioned live PA falls below headroom_trigger_usd, or when no PA is alive. Adds a fresh container when the existing ones become fragile.",
      "cash_buffer": "Greedy, but never spends below cash_reserve_usd, so an existing renewal or pending activation is never stranded by a new purchase."
    },
    "status": "user_selected_2026_08_30"
  },
